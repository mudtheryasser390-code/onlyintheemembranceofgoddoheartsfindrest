<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>أَلا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              black: '#0a0512',
              dark: '#120924',
              card: '#1a0b36',
              purple: '#7c3aed',
              neon: '#a855f7',
              accent: '#c084fc'
            }
          },
          fontFamily: {
            cairo: ['Cairo', 'sans-serif'],
            amiri: ['Amiri', 'serif']
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Cairo', sans-serif;
      background-color: #0a0512;
      color: #f3e8ff;
      overflow-x: hidden;
    }
    
    .text-glow {
      text-shadow: 0 0 15px rgba(168, 85, 247, 0.6), 0 0 30px rgba(124, 58, 237, 0.4);
    }
    
    .box-glow {
      box-shadow: 0 0 25px rgba(124, 58, 237, 0.25);
    }

    .glass-card {
      background: rgba(26, 11, 54, 0.65);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(168, 85, 247, 0.2);
    }

    .glass-card:hover {
      border-color: rgba(168, 85, 247, 0.5);
      box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);
    }

    /* Custom Toast Notification */
    #toast {
      transition: all 0.4s ease;
      transform: translateY(-100px);
      opacity: 0;
    }
    #toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* Particles animation effect */
    .bg-glow-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      z-index: 0;
      pointer-events: none;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between relative bg-brand-black text-white">

  <!-- Background Light Effects -->
  <div class="bg-glow-orb w-96 h-96 bg-purple-900/30 top-0 right-0"></div>
  <div class="bg-glow-orb w-96 h-96 bg-brand-purple/20 bottom-0 left-0"></div>

  <!-- Toast Notification -->
  <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 glass-card bg-brand-purple/90 text-white px-6 py-3 rounded-full shadow-2xl flex items-center space-x-3 space-x-reverse border border-brand-accent">
    <span id="toast-message">مرحباً بك!</span>
  </div>

  <!-- 1. SPLASH SCREEN / INTRO -->
  <div id="splash-screen" class="fixed inset-0 z-40 bg-brand-black/95 flex flex-col items-center justify-center text-center p-6 transition-opacity duration-700">
    <div class="max-w-2xl space-y-8 animate-fade-in">
      <div class="w-24 h-24 mx-auto rounded-full bg-gradient-to-tr from-brand-purple to-brand-neon p-1 box-glow">
        <div class="w-full h-full bg-brand-black rounded-full flex items-center justify-center">
          <svg class="w-12 h-12 text-brand-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
      </div>
      
      <h1 class="font-amiri text-4xl md:text-6xl text-brand-accent text-glow leading-relaxed font-bold">
        أَلا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ
      </h1>

      <p class="text-gray-300 text-lg md:text-xl leading-relaxed max-w-xl mx-auto font-light">
        مرحباً بك في منصتك الخاصة للسكينة والتطوير النفسي والإيماني. مساحتك الخاصة لتغذية الروح وتنظيم الفكر.
      </p>

      <button onclick="enterSite()" class="mt-8 px-10 py-4 bg-gradient-to-r from-brand-purple to-brand-neon text-white font-bold rounded-full shadow-lg hover:scale-105 transition-all duration-300 box-glow text-lg">
        الدخول إلى المنصة
      </button>
    </div>
  </div>

  <!-- 2. NAVBAR -->
  <header class="relative z-10 glass-card border-b border-purple-900/40 py-4 px-6 md:px-12 flex justify-between items-center">
    <div class="flex items-center space-x-3 space-x-reverse">
      <div class="w-10 h-10 rounded-lg bg-brand-purple/30 border border-brand-neon/50 flex items-center justify-center">
        <span class="text-brand-accent font-bold text-xl">📖</span>
      </div>
      <h1 class="font-amiri text-xl md:text-2xl font-bold text-brand-accent text-glow">
        أَلا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ
      </h1>
    </div>

    <div id="user-controls" class="hidden items-center space-x-4 space-x-reverse">
      <span id="user-email-display" class="text-sm text-gray-300 font-mono bg-brand-dark px-3 py-1.5 rounded-lg border border-purple-900"></span>
      <button onclick="logout()" class="text-xs bg-red-600/20 hover:bg-red-600/40 text-red-300 border border-red-500/30 px-3 py-1.5 rounded-lg transition-all">
        تسجيل الخروج
      </button>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="relative z-10 flex-1 flex items-center justify-center p-4 md:p-8">

    <!-- 3. AUTH FORM SECTION -->
    <section id="auth-section" class="w-full max-w-md">
      <div class="glass-card rounded-2xl p-8 shadow-2xl relative overflow-hidden">
        
        <!-- Toggle Tabs -->
        <div class="flex bg-brand-dark/80 p-1 rounded-xl mb-6 border border-purple-900/50">
          <button id="tab-login" onclick="switchTab('login')" class="flex-1 py-2 rounded-lg font-semibold text-sm transition-all bg-brand-purple text-white shadow">
            تسجيل الدخول
          </button>
          <button id="tab-register" onclick="switchTab('register')" class="flex-1 py-2 rounded-lg font-semibold text-sm transition-all text-gray-400 hover:text-white">
            حساب جديد
          </button>
        </div>

        <h2 id="auth-title" class="text-2xl font-bold text-center text-white mb-6">تسجيل الدخول</h2>

        <!-- Step 1: Login / Register Input -->
        <form id="auth-form" onsubmit="handleAuthSubmit(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1">البريد الإلكتروني</label>
            <input type="email" id="email-input" required placeholder="example@mail.com" class="w-full bg-brand-black/60 border border-purple-900 focus:border-brand-neon rounded-xl px-4 py-3 text-white placeholder-gray-500 outline-none transition-all text-sm">
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1">كلمة السر</label>
            <input type="password" id="password-input" required placeholder="••••••••" class="w-full bg-brand-black/60 border border-purple-900 focus:border-brand-neon rounded-xl px-4 py-3 text-white placeholder-gray-500 outline-none transition-all text-sm">
          </div>

          <button type="submit" id="submit-btn" class="w-full bg-gradient-to-r from-brand-purple to-brand-neon hover:opacity-90 text-white font-bold py-3 rounded-xl transition-all shadow-lg box-glow text-sm mt-2">
            تسجيل الدخول
          </button>
        </form>

        <!-- Step 2: Verification Code (Hidden initially) -->
        <div id="verify-section" class="hidden space-y-4 mt-4">
          <p class="text-xs text-gray-300 text-center">
            تم إرسال كود التفعيل المكون من 6 أرقام إلى بريدك الإلكتروني: <br>
            <span id="target-email" class="text-brand-accent font-mono font-semibold"></span>
          </p>

          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1 text-center">أدخل رمز التحقق (6 أرقام)</label>
            <input type="text" id="otp-input" maxlength="6" placeholder="123456" class="w-full bg-brand-black/60 border border-purple-900 focus:border-brand-neon rounded-xl px-4 py-3 text-center text-2xl font-mono tracking-widest text-brand-accent outline-none transition-all">
          </div>

          <button onclick="verifyCode()" class="w-full bg-brand-neon hover:bg-brand-purple text-white font-bold py-3 rounded-xl transition-all shadow-lg text-sm">
            تأكيد وإنشاء الحساب
          </button>

          <button onclick="resendCode()" id="resend-btn" class="w-full text-xs text-gray-400 hover:text-brand-accent transition-all text-center block pt-2">
            إعادة إرسال الرمز
          </button>
        </div>

      </div>
    </section>

    <!-- 4. DASHBOARD / VIDEOS SECTION (Hidden initially) -->
    <section id="dashboard-section" class="hidden w-full max-w-6xl py-6">
      
      <!-- Welcome Bar -->
      <div class="glass-card rounded-2xl p-6 mb-8 border border-brand-purple/30 flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-white mb-1">مرحباً بك مجدداً 👋</h2>
          <p class="text-sm text-gray-400">اختر من الفيديوهات التالية لمساعدتك في المذاكرة والراحة النفسية والاستماع للقرآن الكريم.</p>
        </div>
        <div class="px-4 py-2 bg-brand-purple/20 border border-brand-accent/30 rounded-xl text-brand-accent text-sm font-semibold">
          ✨ محتوى مختار بعناية
        </div>
      </div>

      <!-- Videos Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Card 1: كيفية المذاكرة -->
        <div class="glass-card rounded-2xl overflow-hidden transition-all duration-300 flex flex-col">
          <div class="relative aspect-video w-full">
            <iframe class="w-full h-full" src="https://www.youtube.com/embed/5mGF9Pz916s" title="كيف تذاكر بذكاء" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between">
            <h3 class="font-bold text-lg text-white mb-2">إزاي تذاكر بذكاء وبأعلى تركيز</h3>
            <span class="text-xs text-brand-accent bg-brand-purple/30 w-fit px-2.5 py-1 rounded-md">تطوير الذات والمذاكرة</span>
          </div>
        </div>

        <!-- Card 2: الراحة النفسية -->
        <div class="glass-card rounded-2xl overflow-hidden transition-all duration-300 flex flex-col">
          <div class="relative aspect-video w-full">
            <iframe class="w-full h-full" src="https://www.youtube.com/embed/3f0P9YIInP8" title="ازاي تبقى مرتاح نفسيا" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between">
            <h3 class="font-bold text-lg text-white mb-2">ازاي تبقى مرتاح نفسياً وتتخلص من القلق</h3>
            <span class="text-xs text-brand-accent bg-brand-purple/30 w-fit px-2.5 py-1 rounded-md">صحة نفسية</span>
          </div>
        </div>

        <!-- Card 3: سورة الكهف -->
        <div class="glass-card rounded-2xl overflow-hidden transition-all duration-300 flex flex-col">
          <div class="relative aspect-video w-full">
            <iframe class="w-full h-full" src="https://www.youtube.com/embed/6T_S833jA_E" title="سورة الكهف" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between">
            <h3 class="font-bold text-lg text-white mb-2">سورة الكهف - طمأنينة ونور</h3>
            <span class="text-xs text-brand-accent bg-brand-purple/30 w-fit px-2.5 py-1 rounded-md">القرآن الكريم</span>
          </div>
        </div>

        <!-- Card 4: سورة البقرة -->
        <div class="glass-card rounded-2xl overflow-hidden transition-all duration-300 flex flex-col">
          <div class="relative aspect-video w-full">
            <iframe class="w-full h-full" src="https://www.youtube.com/embed/VDy8G1aXyU8" title="سورة البقرة" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between">
            <h3 class="font-bold text-lg text-white mb-2">سورة البقرة كاملة - البركة والشفاء</h3>
            <span class="text-xs text-brand-accent bg-brand-purple/30 w-fit px-2.5 py-1 rounded-md">القرآن الكريم</span>
          </div>
        </div>

        <!-- Card 5: سورة الواقعة -->
        <div class="glass-card rounded-2xl overflow-hidden transition-all duration-300 flex flex-col">
          <div class="relative aspect-video w-full">
            <iframe class="w-full h-full" src="https://www.youtube.com/embed/N3XvKmsyTsc" title="سورة الواقعة" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between">
            <h3 class="font-bold text-lg text-white mb-2">سورة الواقعة - جلب الرزق والسكينة</h3>
            <span class="text-xs text-brand-accent bg-brand-purple/30 w-fit px-2.5 py-1 rounded-md">القرآن الكريم</span>
          </div>
        </div>

        <!-- Card 6: سورة الملك -->
        <div class="glass-card rounded-2xl overflow-hidden transition-all duration-300 flex flex-col">
          <div class="relative aspect-video w-full">
            <iframe class="w-full h-full" src="https://www.youtube.com/embed/z64MvG5m48A" title="سورة الملك" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between">
            <h3 class="font-bold text-lg text-white mb-2">سورة الملك - المنجية من عذاب القبر</h3>
            <span class="text-xs text-brand-accent bg-brand-purple/30 w-fit px-2.5 py-1 rounded-md">القرآن الكريم</span>
          </div>
        </div>

      </div>

    </section>

  </main>

  <!-- FOOTER -->
  <footer class="relative z-10 glass-card border-t border-purple-900/40 py-4 text-center text-xs text-gray-400">
    <p>جميع الحقوق محفوظة © 2026 - موقع "أَلا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ"</p>
  </footer>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    let currentMode = 'login'; // 'login' or 'register'
    let generatedOtp = null;
    let pendingUserData = null;

    // Toast Function
    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-message');
      toastMsg.textContent = message;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3500);
    }

    // Splash Screen Transition
    function enterSite() {
      const splash = document.getElementById('splash-screen');
      splash.style.opacity = '0';
      setTimeout(() => {
        splash.style.display = 'none';
        checkSession();
      }, 700);
    }

    // Check Active Session
    function checkSession() {
      const activeUser = localStorage.getItem('activeUser');
      if (activeUser) {
        showDashboard(activeUser);
      } else {
        showAuthForm();
      }
    }

    // Switch Login / Register Tabs
    function switchTab(mode) {
      currentMode = mode;
      const tabLogin = document.getElementById('tab-login');
      const tabRegister = document.getElementById('tab-register');
      const authTitle = document.getElementById('auth-title');
      const submitBtn = document.getElementById('submit-btn');

      // Reset Forms
      document.getElementById('auth-form').classList.remove('hidden');
      document.getElementById('verify-section').classList.add('hidden');

      if (mode === 'login') {
        tabLogin.className = 'flex-1 py-2 rounded-lg font-semibold text-sm transition-all bg-brand-purple text-white shadow';
        tabRegister.className = 'flex-1 py-2 rounded-lg font-semibold text-sm transition-all text-gray-400 hover:text-white';
        authTitle.textContent = 'تسجيل الدخول';
        submitBtn.textContent = 'تسجيل الدخول';
      } else {
        tabRegister.className = 'flex-1 py-2 rounded-lg font-semibold text-sm transition-all bg-brand-purple text-white shadow';
        tabLogin.className = 'flex-1 py-2 rounded-lg font-semibold text-sm transition-all text-gray-400 hover:text-white';
        authTitle.textContent = 'إنشاء حساب جديد';
        submitBtn.textContent = 'إرسال كود التفعيل للبريد';
      }
    }

    // Handle Login or Register Form Submit
    function handleAuthSubmit(event) {
      event.preventDefault();
      const email = document.getElementById('email-input').value.trim();
      const password = document.getElementById('password-input').value;

      const users = JSON.parse(localStorage.getItem('users') || '{}');

      if (currentMode === 'login') {
        // LOGIN LOGIC
        if (users[email] && users[email] === password) {
          localStorage.setItem('activeUser', email);
          showToast('تم تسجيل الدخول بنجاح! أهلاً بك.');
          showDashboard(email);
        } else {
          showToast('البريد الإلكتروني أو كلمة السر غير صحيحة!');
        }
      } else {
        // REGISTER LOGIC -> Generate OTP
        if (users[email]) {
          showToast('هذا البريد مسجل بالفعل، يمكنك تسجيل الدخول.');
          switchTab('login');
          return;
        }

        pendingUserData = { email, password };
        generatedOtp = Math.floor(100000 + Math.random() * 900000).toString();
        
        // Simulating Sending Email Code
        document.getElementById('target-email').textContent = email;
        document.getElementById('auth-form').classList.add('hidden');
        document.getElementById('verify-section').classList.remove('hidden');

        showToast(`كود التفعيل التجريبي هو: ${generatedOtp}`);
        console.log("رمز التحقق الخاص بك هو:", generatedOtp);
      }
    }

    // Verify OTP Code
    function verifyCode() {
      const userOtp = document.getElementById('otp-input').value.trim();

      if (userOtp === generatedOtp && pendingUserData) {
        // Save User
        const users = JSON.parse(localStorage.getItem('users') || '{}');
        users[pendingUserData.email] = pendingUserData.password;
        localStorage.setItem('users', JSON.stringify(users));

        // Auto Login
        localStorage.setItem('activeUser', pendingUserData.email);
        
        showToast('تم تأكيد الحساب بنجاح! مرحباً بك.');
        showDashboard(pendingUserData.email);

        // Reset state
        pendingUserData = null;
        generatedOtp = null;
      } else {
        showToast('رمز التحقق غير صحيح، حاول مرة أخرى.');
      }
    }

    // Resend Code
    function resendCode() {
      if (!pendingUserData) return;
      generatedOtp = Math.floor(100000 + Math.random() * 900000).toString();
      showToast(`تم إرسال كود جديد: ${generatedOtp}`);
      console.log("رمز التحقق الجديد:", generatedOtp);
    }

    // Display Dashboard
    function showDashboard(email) {
      document.getElementById('auth-section').classList.add('hidden');
      document.getElementById('dashboard-section').classList.remove('hidden');
      document.getElementById('user-controls').classList.remove('hidden');
      document.getElementById('user-controls').classList.add('flex');
      document.getElementById('user-email-display').textContent = email;
    }

    // Show Auth Form
    function showAuthForm() {
      document.getElementById('auth-section').classList.remove('hidden');
      document.getElementById('dashboard-section').classList.add('hidden');
      document.getElementById('user-controls').classList.add('hidden');
      document.getElementById('user-controls').classList.remove('flex');
    }

    // Logout
    function logout() {
      localStorage.removeItem('activeUser');
      showToast('تم تسجيل الخروج بنجاح.');
      showAuthForm();
      switchTab('login');
    }
  </script>
</body>
</html>
